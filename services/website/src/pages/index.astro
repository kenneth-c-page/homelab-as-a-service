---
// This file controls the content and styling of the HLAAS home page.
// Edit the text in the HTML below to change what visitors read.
// Edit the CSS color variables near the bottom to change the lavender/purple theme.

// Use AstroWind's base layout directly. This keeps the page metadata, global styles,
// and favicon while intentionally leaving out the template's header and footer links.
import Layout from '~/layouts/Layout.astro';

// Browser tab title and search/share description.
// Change these values if you rename HLAAS or want a different summary.
const metadata = {
  title: 'HLAAS — Home Lab as a Service',
  description: 'A simple starting point for exploring and organizing your home lab. - Vibe Coded by yours truly, Lucas Keller',
};
---

<Layout metadata={metadata}>
  <!-- MAIN PAGE WRAPPER: Controls the page background, overall width, and vertical spacing. -->
  <main class="hlaas-page">
    <!-- Decorative background glow. It is visual only; edit the colors in the CSS below. -->
    <div class="background-glow" aria-hidden="true"></div>

    <!-- TOP BRAND ROW: Edit HLAAS and the small caption here. This is plain text, not a link. -->
    <header class="brand-row">
      <div class="brand-lockup">
        <!-- Simple logo tile. Change the letter, or replace it with a text/emoji mark. -->
        <div class="brand-icon" aria-hidden="true">H</div>
        <div class="brand-copy">
          <p class="brand-name">HLAAS</p>
          <p class="brand-caption">HOME LAB AS A SERVICE</p>
        </div>
      </div>

      <!-- Small decorative label; change or remove this whole div if you do not want it. -->
      <p class="top-note"><span class="status-dot" aria-hidden="true"></span> YOUR LAB, YOUR RULES</p>
    </header>

    <!-- HERO AREA: Main page title, short introduction, and decorative dashboard card. -->
    <section class="hero" aria-labelledby="page-title">
      <div class="hero-copy">
        <!-- Eyebrow is the small uppercase line above the main title. -->
        <p class="eyebrow">A HOME FOR YOUR HOMELAB</p>

        <!-- MAIN TITLE: This is the largest heading on the page. Edit this text freely. -->
        <h1 id="page-title">Home Lab<br /><span>as a Service.</span></h1>

        <!-- INTRO TEXT: Replace this sentence with your own project description. -->
        <p class="intro">
          A simple starting point for exploring, organizing, and growing your own home lab.
        </p>

        <!-- This accent line is decorative and has no link or button behavior. -->
        <div class="accent-line" aria-hidden="true"></div>
      </div>

      <!-- VISUAL CARD: A static illustration made from HTML; it does not connect to services. -->
      <aside class="lab-card" aria-label="Example home lab building blocks">
        <div class="card-heading">
          <div>
            <p class="card-kicker">A LITTLE BIT OF EVERYTHING</p>
            <h2>Build your own stack</h2>
          </div>
          <!-- Decorative three-dot window detail. -->
          <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>

        <!-- SERVICE TILES: These are examples only. Edit, remove, or add tiles as your lab changes. -->
        <div class="service-list">
          <div class="service-tile">
            <span class="service-icon dns-icon" aria-hidden="true">⌁</span>
            <span class="service-text"><strong>Pi-hole</strong><small>Network DNS</small></span>
            <span class="service-dot" aria-hidden="true"></span>
          </div>
          <div class="service-tile">
            <span class="service-icon auth-icon" aria-hidden="true">✳</span>
            <span class="service-text"><strong>Authentik</strong><small>Identity</small></span>
            <span class="service-dot" aria-hidden="true"></span>
          </div>
          <div class="service-tile">
            <span class="service-icon k3s-icon" aria-hidden="true">◇</span>
            <span class="service-text"><strong>k3s</strong><small>Container platform</small></span>
            <span class="service-dot" aria-hidden="true"></span>
          </div>
        </div>

        <!-- CARD FOOTER: Change this short sentence or remove the paragraph. -->
        <p class="card-footer"><span aria-hidden="true">✦</span> Start small. Make it yours.</p>
      </aside>
    </section>

    <!-- BOTTOM STRIP: Three short ideas. Edit these labels and descriptions, or delete this section. -->
    <section class="ideas" aria-label="Home lab ideas">
      <article class="idea">
        <span class="idea-number">01</span>
        <div><h2>Explore</h2><p>Try useful tools and services.</p></div>
      </article>
      <article class="idea">
        <span class="idea-number">02</span>
        <div><h2>Connect</h2><p>Bring your systems together.</p></div>
      </article>
      <article class="idea">
        <span class="idea-number">03</span>
        <div><h2>Learn</h2><p>Build skills one project at a time.</p></div>
      </article>
    </section>

    <!-- FOOTER NOTE: Plain text only; this page intentionally has no navigation or page links. -->
    <footer class="page-footer">
      <span>HLAAS</span>
      <span>Made for curious home lab builders.</span>
    </footer>
  </main>
</Layout>

<style>
  /*
   * THEME COLORS: These variables are the quickest way to recolor the page.
   * Lavender and purple are the main colors; white and deep ink provide contrast.
   */
  .hlaas-page {
    --lavender-50: #faf8ff;
    --lavender-100: #f2edff;
    --lavender-200: #e4d9ff;
    --lavender-300: #c9b5ff;
    --purple-500: #8b5cf6;
    --purple-600: #7442dc;
    --purple-700: #5b2eb7;
    --ink: #241b37;
    --muted: #756b87;
    --card: rgba(255, 255, 255, 0.78);

    /* PAGE BACKGROUND: Change the gradients here for a different overall mood. */
    min-height: 100vh;
    box-sizing: border-box;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(1.25rem, 4vw, 3.25rem) clamp(1.25rem, 7vw, 7rem) 1.5rem;
    display: flex;
    flex-direction: column;
    color: var(--ink);
    background:
      radial-gradient(ellipse at 78% 14%, rgba(201, 181, 255, 0.5), transparent 34rem),
      linear-gradient(135deg, var(--lavender-50), #f7f3ff 55%, #f0eaff);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  /* Make the box model predictable for all elements inside this page. */
  .hlaas-page *,
  .hlaas-page *::before,
  .hlaas-page *::after {
    box-sizing: border-box;
  }

  /* SOFT GLOW: Decorative circles behind the content; adjust position/size as desired. */
  .background-glow {
    position: absolute;
    z-index: -1;
    width: 34rem;
    height: 34rem;
    right: -12rem;
    top: 10rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(167, 139, 250, 0.22), rgba(196, 181, 253, 0));
    filter: blur(8px);
    pointer-events: none;
  }

  /* TOP BRAND ROW: Holds the HLAAS name on the left and a small label on the right. */
  .brand-row,
  .brand-lockup,
  .top-note,
  .card-heading,
  .service-tile,
  .page-footer {
    display: flex;
    align-items: center;
  }

  .brand-row {
    width: min(100%, 74rem);
    margin: 0 auto;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand-lockup { gap: 0.75rem; }

  .brand-icon {
    width: 2.7rem;
    height: 2.7rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(116, 66, 220, 0.2);
    border-radius: 0.95rem;
    color: white;
    background: linear-gradient(145deg, var(--purple-500), var(--purple-700));
    box-shadow: 0 0.5rem 1.4rem rgba(91, 46, 183, 0.23);
    font-size: 1.15rem;
    font-weight: 800;
  }

  .brand-copy p { margin: 0; }
  .brand-name { font-size: 0.95rem; font-weight: 850; letter-spacing: 0.12em; }
  .brand-caption { margin-top: 0.12rem !important; color: var(--muted); font-size: 0.6rem; letter-spacing: 0.16em; }

  .top-note {
    gap: 0.5rem;
    margin: 0;
    color: var(--purple-700);
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.12em;
  }

  .status-dot,
  .service-dot {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #9a71f1;
  }

  /* HERO AREA: Main title at left, example service card at right. */
  .hero {
    width: min(100%, 74rem);
    min-height: 28rem;
    margin: auto;
    padding: clamp(3.5rem, 8vw, 7rem) 0 clamp(3rem, 7vw, 5.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 25rem);
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .hero-copy { max-width: 40rem; }

  .eyebrow,
  .card-kicker {
    margin: 0 0 1rem;
    color: var(--purple-600);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  /* MAIN TITLE: Tune font size and line spacing here. */
  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(3.4rem, 8vw, 6.8rem);
    font-weight: 780;
    letter-spacing: -0.075em;
    line-height: 0.98;
  }

  h1 span {
    color: var(--purple-600);
    font-weight: 620;
  }

  .intro {
    max-width: 31rem;
    margin: 1.55rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.17rem);
    line-height: 1.8;
  }

  .accent-line {
    width: 3.5rem;
    height: 0.25rem;
    margin-top: 2rem;
    border-radius: 1rem;
    background: linear-gradient(90deg, var(--purple-500), #c084fc);
  }

  /* SERVICE CARD: White glass-like panel that floats beside the main title. */
  .lab-card {
    width: 100%;
    padding: 1.4rem;
    border: 1px solid rgba(116, 66, 220, 0.13);
    border-radius: 1.5rem;
    background: var(--card);
    box-shadow: 0 1.5rem 4rem rgba(67, 42, 116, 0.11), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px);
  }

  .card-heading { justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; }
  .card-kicker { margin-bottom: 0.35rem; font-size: 0.55rem; letter-spacing: 0.14em; }
  .card-heading h2 { margin: 0; font-size: 1.1rem; letter-spacing: -0.035em; }

  .window-dots { display: flex; gap: 0.25rem; align-self: flex-start; padding-top: 0.3rem; }
  .window-dots i { width: 0.35rem; height: 0.35rem; border-radius: 50%; background: #dfd3f8; }
  .window-dots i:first-child { background: #a984f4; }

  /* SERVICE TILES: The example rows inside the panel. */
  .service-list { display: grid; gap: 0.6rem; }

  .service-tile {
    min-height: 4rem;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid rgba(116, 66, 220, 0.08);
    border-radius: 0.95rem;
    background: rgba(255, 255, 255, 0.72);
  }

  .service-icon {
    width: 2.45rem;
    height: 2.45rem;
    display: grid;
    place-items: center;
    border-radius: 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .dns-icon { color: #6941c6; background: #eee7ff; }
  .auth-icon { color: #9b55c8; background: #f8e8ff; }
  .k3s-icon { color: #5573c6; background: #eaf0ff; }

  .service-text { display: grid; gap: 0.15rem; }
  .service-text strong { font-size: 0.82rem; }
  .service-text small { color: var(--muted); font-size: 0.68rem; }
  .service-dot { width: 0.38rem; height: 0.38rem; margin-left: auto; background: #a984f4; }

  .card-footer {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.72rem;
  }
  .card-footer span { margin-right: 0.35rem; color: var(--purple-600); }

  /* BOTTOM IDEAS: Three short text blocks; they collapse into one column on phones. */
  .ideas {
    width: min(100%, 74rem);
    margin: 0 auto;
    padding: 1.35rem 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(116, 66, 220, 0.14);
    border-bottom: 1px solid rgba(116, 66, 220, 0.14);
  }

  .idea { display: flex; align-items: flex-start; gap: 0.8rem; padding: 0.5rem 1rem; }
  .idea:first-child { padding-left: 0; }
  .idea + .idea { border-left: 1px solid rgba(116, 66, 220, 0.14); }
  .idea-number { padding-top: 0.15rem; color: var(--purple-600); font-size: 0.64rem; font-weight: 800; letter-spacing: 0.1em; }
  .idea h2 { margin: 0; font-size: 0.82rem; }
  .idea p { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.72rem; line-height: 1.5; }

  /* FOOTER: Plain text only, with no page links. */
  .page-footer {
    width: min(100%, 74rem);
    justify-content: space-between;
    gap: 1rem;
    margin: 1.1rem auto 0;
    color: var(--muted);
    font-size: 0.68rem;
  }
  .page-footer span:first-child { color: var(--purple-700); font-weight: 800; letter-spacing: 0.12em; }

  /* RESPONSIVE LAYOUT: Stack the title and card when the screen is narrow. */
  @media (max-width: 760px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 4.5rem 0 3.5rem;
    }
    .lab-card { max-width: 30rem; }
    .ideas { grid-template-columns: 1fr; padding: 0.7rem 0; }
    .idea,
    .idea:first-child { padding: 0.8rem 0; }
    .idea + .idea { border-left: 0; border-top: 1px solid rgba(116, 66, 220, 0.14); }
  }

  /* Small phones: hide the non-essential top label and let footer copy wrap. */
  @media (max-width: 420px) {
    .top-note { font-size: 0.55rem; letter-spacing: 0.06em; }
    .brand-caption { font-size: 0.52rem; }
    .page-footer { align-items: flex-start; flex-direction: column; }
  }

  /* Remove default browser page margin. */
  :global(body) { margin: 0; }
</style>